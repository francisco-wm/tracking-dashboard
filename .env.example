# PostHog personal API key (EU cloud, scope: query:read, projects 60292 + 55666).
# Server-side only: never prefix with NEXT_PUBLIC_.
POSTHOG_PERSONAL_API_KEY=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
# Google OAuth client (Internal consent screen in the wingmaite Workspace).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
